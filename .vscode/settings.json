{
  // Ruff for Python files: format on save + sort imports on save via the Ruff
  // extension. `fromEnvironment` makes the extension use the ruff installed in
  // THIS project's .venv (uv add --dev ruff) instead of its bundled copy.
  // `editor.codeActionsOnSave` runs ruff's import-sort (isort rules) on save.
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports.ruff": "explicit"
    }
  },
  "ruff.importStrategy": "fromEnvironment",
  // Use djLint (not VSCode's built-in HTML formatter) for Jinja2 templates.
  // The built-in formatter doesn't understand {% %} / {{ }} and breaks indent.
  "[html]": {
    "editor.defaultFormatter": "monosans.djlint",
    "editor.formatOnSave": true
  },
  "[jinja]": {
    "editor.defaultFormatter": "monosans.djlint",
    "editor.formatOnSave": true
  },
  "[jinja-html]": {
    "editor.defaultFormatter": "monosans.djlint",
    "editor.formatOnSave": true
  },
  // Run the djlint binary installed in THIS project's .venv, instead of letting
  // the extension run `python -m djlint` with whatever interpreter VSCode's
  // Python extension auto-selected (it picked homebrew python3.14, which has no
  // djlint installed -> "No module named djlint").
  //
  // `djlint.useVenv: false` makes the extension respect `djlint.executablePath`
  // (when useVenv is true, executablePath is IGNORED). The .venv/djlint binary's
  // shebang is #!/Users/admin/fastapi_blog/.venv/bin/python3, so djlint always
  // runs under the project's venv Python — never homebrew.
  "djlint.useVenv": false,
  "djlint.executablePath": ".venv/bin/djlint",
  // Recommended: make the project's active Python interpreter the venv too, so
  // the language server / debugger / running the FastAPI app all use it. If an
  // interpreter was already auto-selected, also run "Python: Select Interpreter"
  // in the Command Palette and pick the .venv once.
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
}